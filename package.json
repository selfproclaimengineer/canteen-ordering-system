{
  "name": "kantin-order",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "node dist/server/main.js",
    "reset-pin": "node dist/server/reset-pin.js",
    "build": "npm run build:server && npm --prefix app run build",
    "dev:app": "npm --prefix app run dev",
    "uji-beban": "node dist/server/uji-beban.js",
    "paket": "npm run build && tar -czf kantin-paket.tgz dist app/build/client package.json package-lock.json README.md docs/deploy-termux.md scripts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  }
}
